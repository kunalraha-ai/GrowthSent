{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "typecheck:vercel": "tsc -p tsconfig.vercel.json",
    "test": "node tests/run-all.mjs",
    "test:common-crawl-ingest": "python tests/common_crawl_wat_ingest.test.py",
    "preflight:production": "tsx lib/cli/production-preflight.ts",
    "smoke:production-function": "tsx --test tests/production-function-smoke.test.ts",
    "benchmark:common-crawl": "tsx lib/cli/common-crawl-benchmark.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@vercel/functions": "3.9.5",
    "bcryptjs": "^3.0.3",
    "bson": "7.3.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldts": "7.0.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
