# GrowthSent Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=growthsent

# Common Crawl Atlas Data Federation (server-side backlink preview only)
# Keep this separate from the operational application database above.
MONGODB_DATA_FEDERATION_URI=mongodb+srv://<username>:<password>@<data-federation-host>/<database>?retryWrites=true&w=majority
MONGODB_DATA_FEDERATION_DB_NAME=growthsent_commoncrawl

# Security & App Settings
SESSION_SECRET=replace-with-a-long-random-session-secret
ENCRYPTION_KEY=replace-with-a-32-byte-base64-encryption-key
# Required for anonymous audit-admission HMACs. This remains server-only.
CRAWL_ADMISSION_SECRET=replace-with-a-separate-long-random-secret
# Required by cron-job.org for GET /api/v1/internal/audit-worker and /health.
CRON_SECRET=replace-with-a-long-random-cron-secret
NEXT_PUBLIC_APP_URL=https://your-growthsent-domain.example

# Browser error monitoring. This is a public Sentry ingest DSN and is embedded
# into the client build; configure it in the Vercel build environment.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Cloudflare Turnstile protects email login and signup. The site key is public
# and compiled into the Vite client; the secret remains server-only in Vercel.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Website Crawler Settings
CRAWLER_USER_AGENT=GrowthSentBot/1.0 (+https://your-growthsent-domain.example)
# Optional first-party Cloudflare bot-management exception. List only hosts
# controlled by this deployment. Keep CRAWLER_FIRST_PARTY_AUDIT_TOKEN server-only
# in Vercel or .env.local; never use a NEXT_PUBLIC_ variable or commit the token.
CRAWLER_FIRST_PARTY_AUDIT_HOSTS=
CRAWLER_FIRST_PARTY_AUDIT_TOKEN=
# Number of cross-instance immediate audit starts permitted after an API
# response. The cron worker remains recovery for jobs that cannot start now.
AUDIT_IMMEDIATE_DISPATCH_SLOTS=3
# The public audit path is hard-bounded in code to 25 pages, depth 5,
# concurrency 5, and a five-second page request timeout. Do not use env vars
# to imply higher public limits.
# Internal-only crawl source selection. Use common-crawl only with durable workers.
CRAWL_DATA_PROVIDER=live

# Persistent external-MVP audit admission is defined in lib/jobs/crawl-admission.ts.

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# All Google callback URIs must use the same canonical public hostname as
# NEXT_PUBLIC_APP_URL. Session and OAuth-state cookies are host-only.
# Google integration callback
GOOGLE_REDIRECT_URI=https://your-growthsent-domain.example/api/v1/integrations/google/callback
# Social-login callbacks (can use the same OAuth client when both URIs are registered)
GOOGLE_LOGIN_REDIRECT_URI=https://your-growthsent-domain.example/api/v1/auth/google/callback
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_LOGIN_REDIRECT_URI=https://your-growthsent-domain.example/api/v1/auth/github/callback
