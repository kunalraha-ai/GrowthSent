# GrowthSent Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=GrowthSent

# Security & App Settings
SESSION_SECRET=replace-with-a-unique-session-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-unique-encryption-secret-at-least-32-characters
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Website Crawler Settings
CRAWLER_USER_AGENT=GrowthSentBot/1.0 (+https://growthsent.com)
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=5
CRAWLER_TIMEOUT=10000
CRAWLER_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_ANONYMOUS_SCANS_PER_IP=10
RATE_LIMIT_AUTHENTICATED_SCANS_PER_USER=100

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/integrations/google/callback
