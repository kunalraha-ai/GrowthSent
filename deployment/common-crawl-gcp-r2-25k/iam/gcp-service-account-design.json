{
  "format_version": 1,
  "purpose": "design only; no GCP policy is applied by this repository",
  "service_accounts": {
    "growthsent-cc-raw-worker": {
      "grants": [
        {
          "role": "roles/secretmanager.secretAccessor",
          "resource_scope": "only the version of the raw R2 temporary-credential secret"
        }
      ],
      "explicitly_not_granted": [
        "roles/owner",
        "roles/editor",
        "Google Cloud Storage data access",
        "Compute Engine administration",
        "Batch job administration",
        "Secret Manager secret write/delete",
        "Artifact Registry write"
      ]
    },
    "growthsent-cc-derive-worker": {
      "grants": [
        {
          "role": "roles/secretmanager.secretAccessor",
          "resource_scope": "only the raw Links read credential and derived R2 write credential secret versions"
        }
      ],
      "explicitly_not_granted": [
        "roles/owner",
        "roles/editor",
        "Google Cloud Storage data access",
        "Compute Engine administration",
        "Batch job administration",
        "Secret Manager secret write/delete",
        "Artifact Registry write"
      ]
    },
    "growthsent-cc-batch-operator": {
      "grants": [
        {"role": "roles/batch.jobsEditor", "resource_scope": "dedicated processing project or folder"},
        {"role": "roles/iam.serviceAccountUser", "resource_scope": "only the two worker service accounts"}
      ],
      "explicitly_not_granted": ["roles/owner", "roles/editor", "worker-secret access"]
    }
  },
  "platform_managed_prerequisite": "Google-managed Batch and Compute Engine service agents must retain their documented service-agent roles; do not grant those roles to GrowthSent worker identities."
}
