{
  "labels": {
    "system": "growthsent-link-index",
    "stage": "compact-recovery",
    "crawl": "cc-main-2026-30"
  },
  "taskGroups": [
    {
      "taskCount": 1,
      "parallelism": 1,
      "taskSpec": {
        "maxRetryCount": 1,
        "maxRunDuration": "21600s",
        "runnables": [
          {
            "container": {
              "imageUri": "REPLACE_WITH_DIGEST_PINNED_ARTIFACT_REGISTRY_IMAGE",
              "entrypoint": "/opt/growthsent/runners/compact-bucket-task.sh"
            }
          }
        ],
        "volumes": [
          {
            "deviceName": "scratch",
            "mountPath": "/mnt/disks/scratch",
            "mountOptions": "rw,async"
          }
        ],
        "computeResource": {
          "cpuMilli": 4000,
          "memoryMib": 60000
        },
        "environment": {
          "variables": {
            "GROWTHSENT_RELEASE_SHA256": "REPLACE_WITH_RELEASE_SHA256",
            "GROWTHSENT_GCS_BUCKET": "growthsent-link-index-498930285709",
            "GROWTHSENT_COMPACTION_RUN_ID": "REPLACE_WITH_EXISTING_COMPACTION_RUN_ID",
            "GROWTHSENT_INPUT_PREFIX": "REPLACE_WITH_COMPLETE_MATERIALIZATION_PREFIX",
            "GROWTHSENT_OUTPUT_PREFIX": "REPLACE_WITH_EXISTING_SERVING_PREFIX",
            "GROWTHSENT_WORK_DIR": "/mnt/disks/scratch/growthsent",
            "GROWTHSENT_TARGET_BUCKET": "REPLACE_WITH_TARGET_BUCKET",
            "GROWTHSENT_DUCKDB_MEMORY_LIMIT": "55GB",
            "GROWTHSENT_DUCKDB_THREADS": "8"
          }
        }
      }
    }
  ],
  "allocationPolicy": {
    "serviceAccount": {
      "email": "growthsent-link-index-runner@growthsent-link-index.iam.gserviceaccount.com"
    },
    "instances": [
      {
        "policy": {
          "machineType": "n2-highmem-8",
          "provisioningModel": "STANDARD",
          "bootDisk": {
            "sizeGb": 50,
            "type": "pd-balanced"
          },
          "disks": [
            {
              "newDisk": {
                "sizeGb": 1000,
                "type": "pd-balanced"
              },
              "deviceName": "scratch"
            }
          ]
        }
      }
    ]
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
